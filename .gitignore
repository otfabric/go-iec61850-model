# Binaries
/bin/
/dist/
/nsdctl

# Test / fuzz
*.test
*.out
testdata/fuzz/

# Coverage output of `make coverage`, in the repository root only
# (docs/coverage.md and the golden coverage reports are tracked).
/coverage.*

# Official IEC source material must never be committed (see docs/licensing.md).
# Synthetic fixtures under testdata/ are the only NSD-shaped files in Git.
*.nsd
*.nsdoc
*.snsd
*.zip
*.xsd
*.pdf
!testdata/**/*.nsd
!testdata/**/*.nsdoc
/work/
/scratch/
/nsd-work/
/generated/
/.generated/
/generated-docs/
.nsd-cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
